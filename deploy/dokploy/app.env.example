# Runtime variables of latifi-api on Dokploy. This file holds names only, never a value.
#
# Copy it outside every repository, fill it in and lock it down:
#   cp deploy/dokploy/app.env.example ~/.latifi/latifi-api.env
#   chmod 600 ~/.latifi/latifi-api.env
# provision.sh reads it, checks it and sends it to Dokploy. A value has no quote, no space and no
# line break. See docs/DEPLOY-DOKPLOY.md for where each value comes from.

# JDBC URL of the tenant database. Internal host of the shared Postgres, for example
# jdbc:postgresql://shared-postgres:5432/latifi. It comes from new-tenant-postgres.sh.
SPRING_DATASOURCE_URL=
# Database user created by new-tenant-postgres.sh for this application only.
SPRING_DATASOURCE_USERNAME=
# Password printed once by new-tenant-postgres.sh. Letters and digits only (hex is fine).
SPRING_DATASOURCE_PASSWORD=
# Signing secret of the access token, at least 32 characters. Make it with: openssl rand -hex 32
LATIFI_JWT_SECRET=
# Public DNS name of the API, the same text as the --host flag, for example api.example.com
LATIFI_AUTH_DOMAIN=
# https:// followed by the same public DNS name. The wallet challenge names it.
LATIFI_AUTH_URI=
# Must be true behind Traefik so the rate limit sees the client address.
LATIFI_TRUST_FORWARDED_FOR=
# Must be framework so Spring trusts the forwarded headers and the OpenAPI server URL is https.
SERVER_FORWARD_HEADERS_STRATEGY=
# https URL of the dedicated Polygon Amoy node, with its key. Copy AMOY_RPC_URL from rpc.env.
LATIFI_RPC_URL=
# LoanBook address on Amoy, 0x followed by 40 hex digits. It is in latifi-contracts/deployments/amoy.json.
LATIFI_LOANBOOK_ADDRESS=
# First block the indexer reads. Run start-block.sh and paste its answer. Never below 51675536.
LATIFI_INDEXER_START_BLOCK=
# true shows Swagger UI and the OpenAPI document on the public URL, false hides both.
LATIFI_SWAGGER_ENABLED=
